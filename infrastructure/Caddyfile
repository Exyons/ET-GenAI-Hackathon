backend.yourdomain.com {
    # 1. Rate Limiting
    max_conns_per_ip 10

    # 2. Public webhook endpoints (no auth — Twilio/Meta POST to these)
    @webhook path /api/sms/webhook /api/whatsapp/webhook
    handle @webhook {
        reverse_proxy backend:8000
    }

    # 3. Authenticated API endpoints
    @auth {
        header X-API-Key {env.SECRET_API_KEY}
    }
    handle @auth {
        reverse_proxy backend:8000
    }

    # Block unauthorized requests
    handle {
        respond "Unauthorized or Rate Limited" 401
    }
}
