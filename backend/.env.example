# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llama3.2-vision

# Database Configuration
CHROMA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Audio Configuration (For future/fallback backend processing)
WHISPER_TTS_MODEL=small

# Debug Mode (set to "true" to enable verbose pipeline logging)
DEBUG_MODE=false

# API Security
SECRET_API_KEY=dev_secret_key_123

# TextBee SMS (primary) — https://textbee.dev
TEXTBEE_API_KEY=your_api_key
TEXTBEE_DEVICE_ID=your_device_id
TEXTBEE_WEBHOOK_SECRET=your_webhook_secret_min_20_chars

# Twilio SMS (fallback)
TWILIO_ACCOUNT_SID=ACxxxxxx
TWILIO_AUTH_TOKEN=xxxxxx
TWILIO_PHONE_NUMBER=+91xxxxxxxxxx

# Meta WhatsApp
META_WHATSAPP_TOKEN=EAAxxxxxx
META_VERIFY_TOKEN=kisan_ai_verify_2024
META_PHONE_NUMBER_ID=1234567890
