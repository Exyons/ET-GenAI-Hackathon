# LLM Provider — "ollama" or "openrouter" (independent for text and vision)
LLM_PROVIDER=ollama
VISION_LLM_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llama3.2-vision

# OpenRouter Configuration (used when LLM_PROVIDER or VISION_LLM_PROVIDER is "openrouter")
OPENROUTER_API_KEY=sk-or-xxxxxxxx
OPENROUTER_MODEL=google/gemini-2.5-flash-preview
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-preview

# Database Configuration (embedding model: all-MiniLM-L6-v2 via onnxruntime)

# Audio Configuration (For future/fallback backend processing)
WHISPER_TTS_MODEL=small

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Debug Mode (set to "true" to enable verbose pipeline logging)
DEBUG_MODE=false

# API Security
SECRET_API_KEY=dev_secret_key_123

# TextBee SMS (primary) — https://textbee.dev
TEXTBEE_API_KEY=your_api_key
TEXTBEE_DEVICE_ID=your_device_id
TEXTBEE_WEBHOOK_SECRET=your_webhook_secret_min_20_chars

# Twilio SMS (fallback)
TWILIO_ACCOUNT_SID=ACxxxxxx
TWILIO_AUTH_TOKEN=xxxxxx
TWILIO_PHONE_NUMBER=+91xxxxxxxxxx

# Meta WhatsApp
META_WHATSAPP_TOKEN=EAAxxxxxx
META_VERIFY_TOKEN=kisan_ai_verify_2024
META_PHONE_NUMBER_ID=1234567890
